# Copy to .env.local (git-ignored): cp .env.example .env.local
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time and are public: never put a secret here.
# RESTART `npm run dev` (or rebuild) after creating or changing this file; a running server keeps the old value.
# Origin of pathway-ai-backend (local Spring Boot API), without a trailing slash or path.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
